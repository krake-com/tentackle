<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tentackle.fx.rdc.login.Login">
  <columnConstraints>
    <ColumnConstraints />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints minHeight="5.0" vgrow="ALWAYS" />
    <RowConstraints vgrow="NEVER" />
    <RowConstraints minHeight="20.0" vgrow="NEVER" />
    <RowConstraints minHeight="20.0" vgrow="NEVER" />
  </rowConstraints>
  <children>
    <GridPane fx:id="loginPane" hgap="5.0" vgap="5.0" GridPane.rowIndex="1">
      <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" maxWidth="1.7976931348623157E308" minWidth="10.0" />
        <ColumnConstraints hgrow="SOMETIMES" maxWidth="1.7976931348623157E308" minWidth="10.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
      </columnConstraints>
      <rowConstraints>
        <RowConstraints vgrow="NEVER" />
        <RowConstraints vgrow="NEVER" />
        <RowConstraints vgrow="NEVER" />
        <RowConstraints vgrow="NEVER" />
      </rowConstraints>
      <children>
        <Label fx:id="backendLabel" text="%Backend:" GridPane.columnIndex="1" GridPane.halignment="RIGHT" />
            <HBox GridPane.columnIndex="2" GridPane.columnSpan="2147483647">
               <children>
              <ComboBox fx:id="backendField" />
              <Button fx:id="backendButton">
                     <HBox.margin>
                        <Insets left="5.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
        <Label fx:id="usernameLabel" text="%Username:" GridPane.columnIndex="1" GridPane.halignment="RIGHT" GridPane.rowIndex="1" />
        <Label fx:id="passwordLabel" text="%Password:" GridPane.columnIndex="1" GridPane.halignment="RIGHT" GridPane.rowIndex="2" />
        <TextField fx:id="usernameField" maxWidth="-Infinity" promptText="%username" GridPane.columnIndex="2" GridPane.columnSpan="2147483647" GridPane.rowIndex="1" />
            <HBox fx:id="passwordBox" GridPane.columnIndex="2" GridPane.columnSpan="2147483647" GridPane.rowIndex="2">
               <children>
              <PasswordField fx:id="passwordField" maxWidth="-Infinity" promptText="%password" />
                  <Button fx:id="revealButton" mnemonicParsing="false">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin></Button>
               </children>
            </HBox>
        <HBox spacing="5.0" GridPane.columnIndex="2" GridPane.columnSpan="2147483647" GridPane.rowIndex="3">
          <children>
            <Button fx:id="loginButton" mnemonicParsing="false" text="%login" />
            <Button fx:id="ssoButton" mnemonicParsing="false" text="%sso login" />
            <Button fx:id="cancelButton" cancelButton="true" mnemonicParsing="false" text="%cancel" />
          </children>
          <GridPane.margin>
            <Insets top="20.0" />
          </GridPane.margin>
        </HBox>
      </children>
      <GridPane.margin>
        <Insets bottom="10.0" left="30.0" right="30.0" top="30.0" />
      </GridPane.margin>
    </GridPane>
    <Label fx:id="messageLabel" maxWidth="1.7976931348623157E308" GridPane.hgrow="ALWAYS" GridPane.rowIndex="2">
      <GridPane.margin>
        <Insets left="10.0" right="10.0" />
      </GridPane.margin>
    </Label>
    <ProgressBar fx:id="progressBar" maxWidth="1.7976931348623157E308" progress="0.0" GridPane.hgrow="ALWAYS" GridPane.rowIndex="3">
      <GridPane.margin>
        <Insets left="10.0" right="10.0" />
      </GridPane.margin>
    </ProgressBar>
  </children>
</GridPane>
