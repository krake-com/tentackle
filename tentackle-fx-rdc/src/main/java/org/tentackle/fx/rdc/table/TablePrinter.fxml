<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<BorderPane fx:id="borderPane" xmlns="http://javafx.com/javafx/8.0.141" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tentackle.fx.rdc.table.TablePrinter">
   <top>
      <Label fx:id="titleLabel" alignment="CENTER" contentDisplay="CENTER" maxWidth="1.7976931348623157E308" text="Title" textAlignment="CENTER" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" />
         </padding>
      </Label>
   </top>
   <bottom>
      <HBox fx:id="bottomLine" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="dateLabel" maxWidth="1.7976931348623157E308" text="xx/xx/xx hh:mm" HBox.hgrow="ALWAYS" />
            <Label fx:id="pageLabel" text="Page 1 of X" />
         </children>
         <HBox.margin>
            <Insets top="10.0" />
         </HBox.margin>
      </HBox>
   </bottom>
   <center>
      <TableView fx:id="tableView" focusTraversable="false" prefHeight="200.0" prefWidth="400.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn prefWidth="75.0" text="C1" />
          <TableColumn prefWidth="75.0" text="C2" />
        </columns>
      </TableView>
   </center>
</BorderPane>
