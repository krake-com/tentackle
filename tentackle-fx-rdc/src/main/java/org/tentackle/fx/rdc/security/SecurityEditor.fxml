<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.40" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tentackle.fx.rdc.security.SecurityEditor">
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
   <center>
      <GridPane hgap="5.0" vgap="5.0" BorderPane.alignment="CENTER">
        <columnConstraints>
          <ColumnConstraints minWidth="10.0" />
          <ColumnConstraints minWidth="10.0" />
          <ColumnConstraints minWidth="10.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="30.0" />
            <RowConstraints minHeight="30.0" />
            <RowConstraints minHeight="30.0" />
            <RowConstraints minHeight="30.0" />
        </rowConstraints>
         <children>
            <TextField fx:id="secGranteeField" prefColumnCount="30" GridPane.columnIndex="1" />
            <Button fx:id="granteeButton" mnemonicParsing="false" text="%select" GridPane.columnIndex="2" />
            <TextArea fx:id="secMessageField" prefRowCount="3" GridPane.columnIndex="1" GridPane.columnSpan="2147483647" GridPane.rowIndex="3" />
            <Label text="%grantee" GridPane.halignment="RIGHT" />
            <Label text="%message" GridPane.halignment="RIGHT" GridPane.rowIndex="3" />
            <HBox alignment="CENTER_LEFT" spacing="20.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <RadioButton fx:id="allowButton" mnemonicParsing="false" text="%allow" />
                  <RadioButton fx:id="denyButton" mnemonicParsing="false" text="%deny" />
               </children>
            </HBox>
            <GridPane fx:id="permissionPane" hgap="5.0" vgap="5.0" GridPane.columnIndex="1" GridPane.columnSpan="2147483647" GridPane.rowIndex="2">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="%permissions" underline="true">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
                  <Label text="%effectivePermissions" underline="true" GridPane.columnIndex="1">
                     <font>
                        <Font name="System Bold" size="13.0" />
                     </font>
                  </Label>
               </children>
            </GridPane>
         </children>
         <padding>
            <Insets bottom="5.0" />
         </padding>
      </GridPane>
   </center>
</BorderPane>
