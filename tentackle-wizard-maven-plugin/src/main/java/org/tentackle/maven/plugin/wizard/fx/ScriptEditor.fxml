<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ChoiceBox?>
<BorderPane prefHeight="480.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/10.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tentackle.maven.plugin.wizard.fx.ScriptEditor">
  <top>
    <HBox alignment="CENTER_LEFT" spacing="5.0">
      <children>
        <Label text="Harness:" />
        <ChoiceBox fx:id="harnessField" prefWidth="250.0" />
      </children>
      <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
      </padding>
    </HBox>
  </top>
  <center>
    <TextArea fx:id="scriptArea" wrapText="false">
      <BorderPane.margin>
        <Insets left="5.0" right="5.0" />
      </BorderPane.margin>
    </TextArea>
  </center>
  <bottom>
    <HBox alignment="CENTER_RIGHT" spacing="5.0">
      <children>
        <Button fx:id="close" mnemonicParsing="false" text="Close" />
        <Button fx:id="run" mnemonicParsing="false" text="Run" />
        <Button fx:id="interrupt" mnemonicParsing="false" text="Interrupt" />
      </children>
      <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
      </padding>
    </HBox>
  </bottom>
</BorderPane>
