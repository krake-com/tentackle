    </TextField>
    <TextField fx:id="genPersistenceImplementation" GridPane.columnIndex="1" GridPane.rowIndex="11">
      <GridPane.margin>
        <Insets right="5.0" />
      </GridPane.margin>
    </TextField>
    <CheckBox fx:id="genRemoteEnabled" mnemonicParsing="false" GridPane.columnIndex="1" GridPane.rowIndex="12" />
    <HBox maxWidth="-Infinity" spacing="5.0" GridPane.columnIndex="1" GridPane.halignment="RIGHT" GridPane.rowIndex="13">
