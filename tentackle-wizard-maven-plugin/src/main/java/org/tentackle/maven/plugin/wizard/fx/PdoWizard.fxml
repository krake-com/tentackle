      <GridPane.margin>
        <Insets top="5.0" />
      </GridPane.margin>
    </Label>
    <Label text="Entity Name:" GridPane.halignment="RIGHT" GridPane.rowIndex="1">
      <padding>
        <Insets left="5.0" />
      </padding>
    </Label>
    <Label text="Super Entity:" GridPane.halignment="RIGHT" GridPane.rowIndex="2">
      <padding>
        <Insets left="5.0" />
