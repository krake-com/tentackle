  private /**/delegate/**/ delegate;          // @wurblet < Inject ${classname}Delegate

  @Override
  public /**/delegate/**/ getDelegate() {  // @wurblet < Inject ${classname}Delegate
    if (delegate == null) {
      delegate = new /**/delegate/**/(this);  // @wurblet < Inject ${classname}Delegate
    }
    return delegate;
  }

