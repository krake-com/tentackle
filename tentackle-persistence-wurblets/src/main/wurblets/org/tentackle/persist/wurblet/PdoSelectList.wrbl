    /**
     * create a list select
     * usage:  \@wurblet <methodname> PdoSelectList --model=<mapfile> [--remote|--local] [--private] [--sort] [--lock] [--append=<sqltext>]
     *                    [--limit] [--offset] [--resultset] [--noif]
     *                    [--tracked|--untracked] [--bounded] [--cursor]
     *                    <key1> ... <keyn>
     *         --remote means "with remote rmi-code" (overrides default)
     *         --local means "without remote rmi-code" (overrides default)
     *         --private makes the method private (default is public, turns on --local as well)
     *         --sort checks for orderBy()-Method
     *         --lock selects FOR UPDATE
     *         --append=... appends an sql-string, i.e. to ORDER BY, GROUP or whatever
     *         --private makes the method private (default is public)
     *         --limit adds a parameter to provide an int following the LIMIT clause
     *         --offset adds a parameter to provide an int following the OFFSET clause
     *         --resultset returns the ResultSetWrapper instead of a list or cursor
     *         --noif "no interface method", i.e. no \@Override will be generated
     *         --tracked return a TrackedList instead of a List (if not [TRACKED] given in model)
     *         --untracked to disable [TRACKED] from model
     *         --bounded returns a bounded List<? extends mainClass> instead of List<mainClass>
     *         --cursor creates ScrollableResource code instead of List
     *
     *         the keys are java-names.
     *
     * Example: \@wurblet selectByArtikelNr PdoSelectList --model=$scripts/artikel.map --remote artikelNr
     */

    assertEntityIsPersistable();

    if (!getExtraParameters().isEmpty()) {
      String msg = "unexpected extra parameters:";
      for (WurbletParameter par: getExtraParameters()) {
        msg += " " + par;
      }
      throw new WurbelException(msg);
    }

    String className  = getClassName();
    String methodName = getMethodName();
    String pdoName    = getPdoClassName();
    String pdoType    = pdoName;
    String poType     = className;
    if (isGenerified()) {
      pdoType = "T";
      poType = "P";
    }

    boolean sort        = false;
    boolean lock        = false;
    String  append      = null;
    boolean limit       = false;
    boolean offset      = false;
    boolean bounded     = false;
    String  cursor      = null;
    boolean resultSet   = false;
    boolean noif        = false;
    String  scope       = "public";

    for (String arg: getOptionArgs())  {
      if (arg.equals("private")) {
        scope = "private";
      }
      else if (arg.equals("sort")) {
        if (isWithDefaultSorting()) {
          if (isWithSorting()) {
            throw new WurbelException("either default sorting (--sort) or explicit sorting (+/-AN) allowed");
          }
          sort = true;
        }
        else {
          throw new WurbelException("no sorting configured in model for " + getEntity());
        }
      }
      else if (arg.equals("noif")) {
        noif = true;
      }
      else if (arg.equals("lock")) {
        lock = true;
      }
      else if (arg.equals("limit")) {
        limit = true;
      }
      else if (arg.equals("offset")) {
        offset = true;
      }
      else if (arg.equals("bounded")) {
        bounded = true;
      }
      else if (arg.equals("resultset")) {
        resultSet = true;
      }
      else if (arg.equals("cursor")) {
        cursor = "ScrollableResource<" + pdoName + ">";
      }
      else if (arg.startsWith("append=")) {
        append = arg.substring(7);
      }
    }

    if (scope.equals("private")) {
      setRemote(false);
      noif = true;
    }

    if (resultSet) {
      setRemote(false);     // disable remoting for sure
    }

    if (cursor != null) {
      if (resultSet) {
        throw new WurbelException("resultset not allowed with cursor");
      }
      if (isTracked()) {
        throw new WurbelException("tracked not available with cursors!");
      }
      if (!getJoins().isEmpty()) {
        List<WurbletParameter> sortKeys = getSortingParameters();
        if (sortKeys.isEmpty() || !sortKeys.get(0).getAttribute().getColumnName().equals(Constants.CN_ID)) {
          throw new WurbelException("cursors with joins must be sorted by ID");
        }
      }
    }


    String params = buildMethodParameters(limit, offset);
    String iparms = buildInvocationParameters(limit, offset);
    String statementId = createStatementId();
    String reflMethod = getGuardName() + "Method";
    String poImpl = deriveClassNameForEntity(getEntity());

    String listType = resultSet ? "ResultSetWrapper" :
                        (cursor != null ?
                          ("ScrollableResource<" + (bounded ? "? extends " : "") + pdoType + ">") :
                          ((isTracked() ? "TrackedList" : "List") + "<" + (bounded ? "? extends " : "") + pdoType + ">"));
    String varListType = cursor != null ? cursor : ((isTracked() ? "TrackedList" : "List") + "<" + pdoType + ">");
    String rmiListType = cursor != null ? cursor : ((isTracked() ? "TrackedList" : "List") + "<" + (bounded ? "? extends " : "") + pdoType + ">");
    boolean whereWithAliases = true;   // for genwhere.incl

    String alias = getEntity().getTopSuperEntity().getTableAlias();

]@

  private static final StatementId @(statementId)@ = new StatementId();

@[
    if (!noif) {
]@
  \@Override
@[
    }
]@
  @(scope)@ @(listType)@ @(methodName)@(@(as(params))@) {
@[
    if (isRemote()) {
      // create includes
      RemoteIncludes genInc = new RemoteIncludes(this);
      PrintStream implOut   = genInc.getImplStream();
      PrintStream remoteOut = genInc.getRemoteStream();
]@
    if (getSession().isRemote())  {
      // invoke remote method
      try {
@[
      if (cursor != null) {
]@
@{to remoteOut}@
  RemoteResultSetCursor @(methodName)@(@(pcs(params, "DomainContext context"))@) throws RemoteException;
@{to implOut}@

  \@Override
  public RemoteResultSetCursor @(methodName)@(@(pcs(params, "DomainContext context"))@) throws RemoteException {
    try {
      setDomainContext(context);
      dbObject.assertRootEntity();
      return createRemoteResultSetCursorDelegate(dbObject.@(methodName)@(@(iparms)@));
    }
    catch (Exception e) {
      throw createException(e);
    }
  }
@{to}@
        return new ResultSetCursor<>(getSession(), getRemoteDelegate().
            @(methodName)@(@(pcs(iparms, "getDomainContext()"))@));
@[
      } // end if cursor
      else {
]@
@{to remoteOut}@
  @(rmiListType)@ @(methodName)@(@(pcs(params, "DomainContext context"))@) throws RemoteException;
@{to implOut}@

  \@Override
  public @(rmiListType)@ @(methodName)@(@(pcs(params, "DomainContext context"))@) throws RemoteException {
    try {
      setDomainContext(context);
      return dbObject.@(methodName)@(@(iparms)@);
    }
    catch (Exception e) {
      throw createException(e);
    }
  }
@{to}@
        @(listType)@ list = getRemoteDelegate().@(methodName)@(@(pcs(iparms, "getDomainContext()"))@);
        configureRemoteObjects(getDomainContext(), list);
        return list;
@[
      }
]@
      }
      catch (RemoteException e) {
        throw PersistenceException.createFromRemoteException(this, e);
      }
    }
    // else: local mode
@[
    } // end if remote

    if (!getJoins().isEmpty()) {
]@
    JoinedSelect<@(pdoType)@> js = new JoinedSelect<>();
@[
      int joinCount = 0;
      for (Relation join: getJoins()) {
        joinCount++;
        String joinClass = join.getForeignEntity().getName();
        String joinAlias = join.getForeignEntity().getTopSuperEntity().getTableAlias();
        if (join.getRelationType() == RelationType.LIST) {
]@
    js.addJoin(
      new Join<>(JoinType.LEFT, getColumnName(CN_ID), "j_@(joinCount)@.@(join.getForeignAttribute().getColumnName())@", @(joinClass)@.class, "j_@(joinCount)@",
        (@(alias)@, @(joinAlias)@) -> {
          @(poImpl)@ po = (@(poImpl)@) @(alias)@.getPersistenceDelegate();
@[
          if (join.isReversed()) {
]@
          po.@(join.getSetterName())@(@(joinAlias)@);
@[
          }
          else {
]@
          po.@(join.getGetterName())@Blunt().add(@(joinAlias)@);
@[
          }
]@
        }
      )
    );
@[
        }
        else  { // RelationType.OBJECT
]@
    js.addJoin(
      new Join<>(JoinType.LEFT, getColumnName(CN_@(join.getAttribute().getJavaName().toUpperCase())@), "j_@(joinCount)@.id", @(joinClass)@.class, "j_@(joinCount)@",
        (@(alias)@, @(joinAlias)@) -> {
          @(alias)@.@(join.getSetterName())@(@(joinAlias)@);
        }
      )
    );
@[
        }
      }
    }
]@
    PreparedStatementWrapper st = getPreparedStatement(@(statementId)@,
      () -> {
        StringBuilder sql = createSelectAllInnerSql();
@{include $currentDir/genwhere.incl}@
        getBackend().buildSelectSql(sql, @(lock ? "true" : "false")@, @(limit ? "limit" : "0")@, @(offset ? "offset" : "0")@);
@[

    if (sort) {
]@
        String orderSuffix = orderBy();
        if (orderSuffix != null && !orderSuffix.isEmpty()) {
          sql.append(Backend.SQL_ORDERBY).append(orderSuffix);
        }
@[
    }
    if (append != null)  {
]@
        sql.append(' ');
        sql.append(@(append)@);
@[
    }
]@@{include $currentDir/genjoinsql.incl}@
        return sql.toString();
      }
    );
@[
    if (limit || offset) {
]@
    int ndx = getBackend().setLeadingSelectParameters(st, @(limit ? "limit" : "0")@, @(offset ? "offset" : "0")@);
@[
    }
    else  {
]@
    int ndx = 1;
@[
    }

    if (!getJoins().isEmpty()) {
]@
    ndx = js.setClassIdsInStatement(st, ndx);
@[
    }
]@
@{include $currentDir/gensetpar.incl}@
@[
    if (limit || offset) {
]@
    getBackend().setTrailingSelectParameters(st, ndx, @(limit ? "limit" : "0")@, @(offset ? "offset" : "0")@);
@[
    }

    if (resultSet) {
]@
    return st.executeQuery();
@[
    }
    else  {
      if (cursor != null) {
]@
    ResultSetWrapper rs = st.executeQuery();
@[
        if (getJoins().isEmpty()) {
]@
    return new ResultSetCursor<>(pdo(), rs);
@[
        }
        else  {
]@
    return new ResultSetCursor<>(pdo(), rs, js));
@[
        }
      } // end if cursor
      else  { // list
        if (isTracked())  {
          if (getJoins().isEmpty()) {
]@
    return executeTrackedListQuery(st);
@[
          }
          else  {
]@
    return executeTrackedListQuery(st, js);
@[
          }
        }
        else  {
          if (getJoins().isEmpty()) {
]@
    return executeListQuery(st);
@[
          }
          else  {
]@
    return executeListQuery(st, js);
@[
          }
        }
      }   // end if list
    }   // end !resultset
]@
  }

