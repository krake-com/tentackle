    /**
     * Generates the remote delegate invocation code.
     *
     * Use this wurblet if the local part of the method is hard coded but you want
     * to generate the code to invoke the delegate's method.
     * In order for this wurblet to work, the method must be annotated with \@Analyze.
     * By default, the wurblet's guardname is the name of the method. If the method name is
     * not unique within the class, the annotation can optionally take an individual tag
     * that equals the guardname.
     *
     * Notice: the annotation is not strictly necessary, if the method name is unique
     * within the class. However, we enforce its use for documentation purposes. Manually written
     * database code should always be annotated, even if the delegate invocation code is
     * not generated by this wurblet.
     *
     * What can be generated by this wurblet:
     *
     * - methods with arguments or return types of:
     *   + simple types like primitives, String, Date, etc...
     *   + AbstractDbObject, PDO or a List or TrackedArrayList of AbstractDbObject/PDO.
     *
     * - static methods with their first argument being "Session session"
     *
     * Objects not starting with java.lang... are assumed to have a class type of the className.
     * Furthermore, List<T> and TrackedArrayList<T> are assumed with T = className.
     *
     * usage:  \@wurblet <guardname> RemoteMethod --remote [--name=<methodname>] [--this] [--instance=...]
     *
     * args:  argName1... formal parameter names. For static methods, 'session' must be omitted. 'this' can be added once.
     *
     *        --remote must be given to generate code at all
     *        --name=<methodname> optional methodname overriding <guardname>
     *        --this to add 'this' to the invocation and set the Db
     *        --nocontext don't pass domaincontext
     *        --instance=<nameofinstancevariable> to invoke the method on
     *
     * Example:
     *
     * \@Analyze
     * public List<Account> selectAccounts(String code, long principalId) {
     *
     *   // \@wurblet selectAccounts RemoteMethod
     */

    String methodName     = null;
    String instanceName   = null;
    boolean addThis       = false;
    boolean noContext     = false;

    for (String arg: getOptionArgs())  {
      if (arg.startsWith("name=")) {
        methodName = arg.substring(5);
      }
      else if (arg.startsWith("instance=")) {
        instanceName = arg.substring(9);
      }
      else if (arg.equals("this")) {
        addThis = true;
      }
      else if (arg.equals("nocontext")) {
        noContext = true;
      }
    }

    if (methodName == null) {
      methodName = getContainer().getProperty(Wurbler.PROPSPACE_WURBLET, "guardname");
    }

    String className = getContainer().getProperty(Wurbler.PROPSPACE_WURBLET, JavaSourceType.CLASS_NAME);
    if (className == null)  {
      throw new WurbelException("can't determine <classname>");
    }

    String packageName = getContainer().getProperty(Wurbler.PROPSPACE_WURBLET, JavaSourceType.PACKAGE_NAME);
    if (packageName == null)  {
      throw new WurbelException("can't determine <packagename>");
    }

    boolean isPdo = false;
    String pdoClassName = null;
    try {
      pdoClassName = getPdoClassName();
      isPdo = true;
    }
    catch (WurbelException wx) {
      // no pdo
    }

    if (isRemote()) {

      // load the info file
      String infoName = (packageName + "." + className + "." + methodName).replace('.', '/') + RemoteMethodInfo.INFO_FILE_EXTENSION;
      RemoteMethodInfo info = null;
      try {
        info = RemoteMethodInfo.readInfo(getContainer().getAnalyzeFile(infoName));
      }
      catch (Exception ex) {
        throw new WurbelException("reading info " + infoName + " failed", ex);
      }

      RemoteMethodHelper helper = new RemoteMethodHelper(info, pdoClassName, addThis);

      boolean returningObject     = helper.isReturningObject();
      boolean returningCollection = helper.isReturningCollection();
      boolean returningCursor     = helper.isReturningCursor();
      boolean returningVoid       = helper.isReturningVoid();

      // get the real method name
      methodName = helper.getMethodName();

      if (helper.isStaticMethod()) {
        throw new WurbelException("static methods cannot be --remote");
      }

      // generate strings
      String iparms  = helper.getInvocationParameterString();
      String riparms = helper.getRemoteInvocationParameterString();
      String dparms  = helper.getDeclarationParameterString();

      if (isPdo && !addThis && !noContext) {
        if (iparms.length() > 0) {
          iparms = "getDomainContext(), " + iparms;
        }
        else {
          iparms = "getDomainContext()";
        }

        if (dparms.length() > 0) {
          dparms = "DomainContext context, " + dparms;
        }
        else  {
          dparms = "DomainContext context";
        }
      }

      String returnType = helper.getReturnType();
      String genType = helper.getGenericReturnType();

      String firstName  = helper.getFirstName();
      boolean firstIsDb = helper.isFirstInstanceOfDb();
      boolean firstIsDomainContext = helper.isFirstInstanceOfDomainContext();

      String remoteDelegateName = (pdoClassName != null ? pdoClassName : className) + "RemoteDelegate";
      String imethod = "getRemoteDelegate()";

      String setDomainContext = "setDomainContext(" + firstName + ")";

      String apply = null;
      if (returningObject) {
        apply = "configureRemoteObject(getDomainContext(), obj)";
      }
      else if (returningCollection) {
        apply = "configureRemoteObjects(getDomainContext(), list)";
      }

      // always use a fresh pdo because we don't know what the app is really doing with it
      String dbObject = "newInstance(" + (firstIsDomainContext ? firstName : "context") + ")";
      if (!isPdo || noContext) {
        dbObject = "dbObject";
      }
      if (addThis) {
        dbObject = "obj";
      }
      else if (instanceName != null) {
        dbObject = instanceName;
      }

      // create includes
      RemoteIncludes genInc = new RemoteIncludes(this);
      PrintStream implOut   = genInc.getImplStream();
      PrintStream remoteOut = genInc.getRemoteStream();
]@
    if (getSession().isRemote())  {
      // invoke remote method
      try {
@[


      if (returningObject) {
]@
@{to remoteOut}@
  public @(className)@ @(methodName)@(@(dparms)@) throws RemoteException;
@{to implOut}@

  \@Override
  public @(className)@ @(methodName)@(@(dparms)@) throws RemoteException {
    try {
@[
        if (firstIsDomainContext) {
]@
      @(setDomainContext)@;
@[
        }
        if (addThis) {
]@
      obj.setSession(getSession());
@[
        }
        for (String statement: helper.getUpdateDbInParametersStatements()) {
]@
      @(statement)@;
@[
        }
]@
      return @(dbObject)@.@(methodName)@(@(riparms)@);
    }
    catch (Exception e) {
      throw createException(e);
    }
  }
@{to}@
        @(className)@ obj = @(imethod)@.@(methodName)@(@(iparms)@);
        @(apply)@;
        return obj;
@[
      }


      if (returningCollection) {
]@
@{to remoteOut}@
  public @(returnType)@ @(methodName)@(@(dparms)@) throws RemoteException;
@{to implOut}@

  \@Override
  public @(returnType)@ @(methodName)@(@(dparms)@) throws RemoteException {
    try {
@[
        if (firstIsDomainContext) {
]@
      @(setDomainContext)@;
@[
        }
        if (addThis) {
]@
      obj.setSession(getSession());
@[
        }
        for (String statement: helper.getUpdateDbInParametersStatements()) {
]@
      @(statement)@;
@[
        }
]@
      return @(dbObject)@.@(methodName)@(@(riparms)@);
    }
    catch (Exception e) {
      throw createException(e);
    }
  }
@{to}@
        @(returnType)@ list = @(imethod)@.@(methodName)@(@(iparms)@);
        @(apply)@;
        return list;
@[
      }


      else if (returningCursor) {
]@
@{to remoteOut}@
  public RemoteResultSetCursor@(genType)@ @(methodName)@(@(dparms)@) throws RemoteException;
@{to implOut}@

  \@Override
  public RemoteResultSetCursor@(genType)@ @(methodName)@(@(dparms)@) throws RemoteException {
    try {
@[
        if (firstIsDomainContext) {
]@
      @(setDomainContext)@;
@[
        }
        if (addThis) {
]@
      obj.setSession(getSession());
@[
        }
        for (String statement: helper.getUpdateDbInParametersStatements()) {
]@
      @(statement)@;
@[
        }
]@
      return createRemoteResultSetCursorDelegate(@(dbObject)@.@(methodName)@(@(riparms)@));
    }
    catch (Exception e) {
      throw createException(e);
    }
  }
@{to}@
@[
        if (isPdo) {
]@
        return new ResultSetCursor<>(getDomainContext(),
                     @(imethod)@.@(methodName)@(@(iparms)@));
@[
        }
        else  {
]@
        return new ResultSetCursor<>(getSession(),
                     @(imethod)@.@(methodName)@(@(iparms)@));
@[
        }
      }

      else if (returningVoid) {
]@
@{to remoteOut}@
  public void @(methodName)@(@(dparms)@) throws RemoteException;
@{to implOut}@

  \@Override
  public void @(methodName)@(@(dparms)@) throws RemoteException {
    try {
@[
        if (firstIsDomainContext) {
]@
      @(setDomainContext)@;
@[
        }
        if (addThis) {
]@
      obj.setSession(getSession());
@[
        }
        for (String statement: helper.getUpdateDbInParametersStatements()) {
]@
      @(statement)@;
@[
        }
]@
      @(dbObject)@.@(methodName)@(@(riparms)@);
    }
    catch (Exception e) {
      throw createException(e);
    }
  }
@{to}@
        @(imethod)@.@(methodName)@(@(iparms)@);
        return;
@[
      }


      else  {
]@
@{to remoteOut}@
  public @(returnType)@ @(methodName)@(@(dparms)@) throws RemoteException;
@{to implOut}@

  \@Override
  public @(returnType)@ @(methodName)@(@(dparms)@) throws RemoteException {
    try {
@[
        if (firstIsDomainContext) {
]@
      @(setDomainContext)@;
@[
        }
        if (addThis) {
]@
      obj.setSession(getSession());
@[
        }
        for (String statement: helper.getUpdateDbInParametersStatements()) {
]@
      @(statement)@;
@[
        }
]@
      return @(dbObject)@.@(methodName)@(@(riparms)@);
    }
    catch (Exception e) {
      throw createException(e);
    }
  }
@{to}@
        return @(imethod)@.@(methodName)@(@(iparms)@);
@[
