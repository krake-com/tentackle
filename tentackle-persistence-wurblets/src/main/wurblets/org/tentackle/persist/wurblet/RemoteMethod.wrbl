      obj.setSession(getSession());
@[
        }
        for (String statement: helper.getUpdateDbInParametersStatements()) {
]@
      @(statement)@;
@[
        }
]@
      return @(dbObject)@.@(methodName)@(@(riparms)@);
    }
    catch (Exception e) {
      throw createException(e);
    }
  }
@{to}@
        @(returnType)@ list = @(imethod)@.@(methodName)@(@(iparms)@);
        @(apply)@;
        return list;
@[
