    /**
     * create a code for setting up the field names.
     *
     * usage:  \@wurblet <somename> ClassVariables --model=<mapfile>
     */


    String pdoName    = getPdoClassName();
    String className  = getClassName();
    boolean multiInheritance = getEntity().getHierarchyInheritanceType() == InheritanceType.MULTI;
    Entity superEntity = getEntity().getSuperEntity();
    List<Entity> subEntities = getEntity().getSubEntities();

]@
  /** Variables common to all instances of @(className)@. */
@[
    if (getEntity().isAbstract() && getEntity().getInheritanceType().isMappingToNoTable()) {  // PLAIN
]@
  /** no classvariables for @(getEntity().getInheritanceType())@ inheritance. */
@[
    }
    else  {
      String cvType = "PersistentObjectClassVariables";
      String cvImpliedType = cvType;
      if (!getEntity().isAbstract()) {
        cvType += "<" + pdoName + ", " + className + ">";
        cvImpliedType += "<>";
      }
      String alias = getEntity().getTableAlias();
      String strAlias = alias != null ? "\"" + alias + "\"" : "null";
      String superCV = "null";

      List<Relation> joins = getEagerRelations();

      if (superEntity != null && !superEntity.getInheritanceType().isMappingToNoTable() ||
          !subEntities.isEmpty()) {
        if (superEntity != null) {
          superCV = deriveClassNameForEntity(superEntity) + ".CLASSVARIABLES";
]@
  \@SuppressWarnings({"unchecked", "FieldNameHidesFieldInSuperclass"})
@[
        }
        else {
]@
  \@SuppressWarnings("unchecked")
@[
        }
      }
      else {
]@
  \@SuppressWarnings("unchecked")
@[
      }
]@
  public static final @(cvType)@ CLASSVARIABLES =
            new @(cvImpliedType)@(
                    @(pdoName)@.class,
                    @(className)@.class,
                    @(strAlias)@,
                    @(superCV)@,
@[
      if (joins != null) {
        String poImpl = deriveClassNameForEntity(getEntity());
]@
                    Arrays.asList(
@[
        int joinCount = 0;
        for (Relation join: joins) {
          joinCount++;
          String joinClass = join.getForeignEntity().getName();
          String joinAlias = join.getForeignEntity().getTopSuperEntity().getTableAlias();
          if (join.getForeignEntity().isAbstract()) {
            if (join.getRelationType() == RelationType.LIST) {
]@
                      new Join<>(JoinType.LEFT, "@(alias)@.id", "e_@(joinCount)@.@(join.getForeignAttribute().getColumnName())@", @(joinClass)@.class, "e_@(joinCount)@",
                        (@(pdoName)@ @(alias)@, @(joinClass)@ @(joinAlias)@) -> {
                          @(poImpl)@ po = (@(poImpl)@) @(alias)@.getPersistenceDelegate();
                          po.@(join.getGetterName())@Blunt().add(@(joinAlias)@);
                        }
                      @(joinCount < joins.size() ? ")," : ")")@
@[
            }
            else {
]@
                      new Join<>(JoinType.LEFT, "@(alias)@.@(join.getAttribute().getColumnName())@", "e_@(joinCount)@.id", @(joinClass)@.class, "e_@(joinCount)@",
                        (@(pdoName)@ @(alias)@, @(joinClass)@ @(joinAlias)@) -> {
                          @(alias)@.@(join.getSetterName())@(@(joinAlias)@);
                        }
                      @(joinCount < joins.size() ? ")," : ")")@
@[
            }
          }
          else  { // non-abstract
            if (join.getRelationType() == RelationType.LIST) {
]@
                      new Join<@(pdoName)@,@(joinClass)@>(JoinType.LEFT, "@(alias)@.id", "e_@(joinCount)@.@(join.getForeignAttribute().getColumnName())@", @(joinClass)@.class, "e_@(joinCount)@",
                        (@(alias)@, @(joinAlias)@) -> {
@[
          if (join.isReversed()) {
]@
                        ((@(poImpl)@) @(alias)@.getPersistenceDelegate()).@(join.getSetterName())@(@(joinAlias)@);
@[
          }
          else {
]@
                        ((@(poImpl)@) @(alias)@.getPersistenceDelegate()).@(join.getGetterName())@Blunt().addBlunt(@(joinAlias)@);
@[
            if (join.getLinkMethodName() != null) {
              String joinImpl = deriveClassNameForEntity(join.getForeignEntity());
]@
                        ((@(joinImpl)@) @(joinAlias)@.getPersistenceDelegate()).@(createRelationUpdateReferenceCode(join, alias))@;
@[
            }
          }
]@
                        }
                      @(joinCount < joins.size() ? ")," : ")")@
@[
            }
            else {
]@
                      new Join<@(pdoName)@,@(joinClass)@>(JoinType.LEFT, "@(alias)@.@(join.getAttribute().getColumnName())@", "e_@(joinCount)@.id", @(joinClass)@.class, "e_@(joinCount)@",
                        (@(alias)@, @(joinAlias)@) -> {
                          @(alias)@.@(join.getSetterName())@(@(joinAlias)@);
                        }
                      @(joinCount < joins.size() ? ")," : ")")@
@[
            }
          }
        }
]@
                    )
                );
@[
      }
      else {
]@
                    null);
@[
      }
]@

  \@Override
@[
  if (getEntity().isAbstract()) {
]@
  \@SuppressWarnings("unchecked")
@[
  }
]@
  public @(cvType)@ getClassVariables() {
    return CLASSVARIABLES;
  }
@[
    }
]@
