]@
      cache = new @(cache)@<@(pdoName)@> (@(pdoName)@.class, @(preload ? "true" : "false")@, @(mutable ? "false" : "true")@, @(secure ? "true" : "false")@);
@[
      }
      else {
]@
      cache = Pdo.createPdoCache(@(pdoName)@.class, @(preload ? "true" : "false")@, @(mutable ? "false" : "true")@, @(secure ? "true" : "false")@);
@[
      }

      if (strategy != null) {
]@
      cache.setStrategy(PdoCacheStrategy.@(strategy)@);
@[
      }

