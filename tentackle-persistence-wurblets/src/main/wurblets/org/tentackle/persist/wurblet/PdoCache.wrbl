]@
@{to remoteOut}@
  @(pdoName)@ selectByUniqueDomainKeyForCache(DomainContext context, @(udkType)@ @(udkName)@) throws RemoteException;
@{to implOut}@

  \@Override
  public @(pdoName)@ selectByUniqueDomainKeyForCache(DomainContext context, @(udkType)@ @(udkName)@) throws RemoteException {
