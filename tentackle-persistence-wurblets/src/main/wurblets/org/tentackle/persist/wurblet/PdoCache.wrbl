   */
  \@Override
  public @(pdoType)@ selectCachedOnlyByUniqueDomainKey(@(udkType)@ @(udkName)@)  {
    return @(filterBegin)@getCache().select(@(indexMethod)@(), getDomainContext(), @(udkName)@, false)@(filterEnd)@;
  }

  /**
   * Selects via cache by unique domain key.
