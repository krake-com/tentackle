  /** the cache. */
  @(scope)@ static @(cache)@<@(pdoName)@> cache;
@[
    for (WurbletParameter key: getExpressionParameters()) {
      String type = key.getAttribute().getJavaType();
]@

  /** index for @(key.getName())@. */
  @(scope)@ static PdoCacheIndex<@(pdoName)@,@(type)@> @(key.getName())@Index;
@[
    }

    if (genudk) {
]@

  /** index for the unique domain key. */
  @(scope)@ static PdoCacheIndex<@(pdoName)@,@(udkType)@> udkIndex;
@[
    }
]@

  /**
   * Creates the cache singleton if it does not exist.
   *
   * \@return the cache singleton
   */
  private static synchronized @(cache)@<@(pdoName)@> createCache() {
    if (cache == null) {
@[
    if (noreg) {
]@
      cache = new @(cache)@<@(pdoName)@> (@(pdoName)@.class, @(preload ? "true" : "false")@, @(mutable ? "false" : "true")@, @(secure ? "true" : "false")@);
@[
    }
    else {
]@
      cache = Pdo.createPdoCache(@(pdoName)@.class, @(preload ? "true" : "false")@, @(mutable ? "false" : "true")@, @(secure ? "true" : "false")@);
@[
    }

    if (strategy != null) {
]@
      cache.setStrategy(PdoCacheStrategy.@(strategy)@);
@[
    }

    if (maxSize != null) {
]@
      cache.setMaxSize(@(maxSize)@);
@[
    }

    if (keepQuota != null) {
]@
      cache.setKeepQuota(@(keepQuota)@);
@[
    }

    if (configure != null) {
]@
      @(configure)@(cache);
@[
    }

    for (WurbletParameter key: getExpressionParameters()) {
      String type   = key.getAttribute().getJavaType();
      String suffix = key.getAttribute().getMethodNameSuffix();
]@

      @(key.getName())@Index = new PdoCacheIndex<@(pdoName)@,@(type)@>("@(pdoName)@:@(key.getName())@") {

          \@Override
          public @(pdoName)@ select(DomainContext context, @(type)@ @(key.getArg())@) {
            return Pdo.create(@(pdoName)@.class, context).selectBy@(suffix)@(@(key.getArg())@);
          }

          \@Override
          public @(type)@ extract(@(pdoName)@ pdo) {
            return pdo.get@(suffix)@();
          }
        };
@[
    }

    if (genudk) {
]@

      udkIndex = new PdoCacheIndex<@(pdoName)@,@(udkType)@>("@(pdoName)@:UDK") {

          \@Override
          public @(pdoName)@ select(DomainContext context, @(udkType)@ @(udkName)@) {
            return Pdo.create(@(pdoName)@.class, context).findByUniqueDomainKey(@(udkName)@);
          }

          \@Override
          public @(udkType)@ extract(@(pdoName)@ pdo) {
            return pdo.get@(udkSuffix)@();
          }
        };
@[
    }

]@

      PdoTracker.getInstance().addModificationListener(new PdoListener(@(pdoName)@.class) {

        \@Override
        public void dataChanged(ModificationEvent ev) {
@[
      if (delayed)  {
]@
          cache.expire(ev.getSerial()); // delayed expiration
@[
      }
      else {
]@
          cache.expire(ev.getSession(), ev.getSerial()); // immediate expiration
@[
      }
]@
        }
      });
    }
    return cache;
  }

  \@Override
  public PdoCache<@(pdoName)@> getCache() {
    return cache == null ? createCache() : cache;
  }

  \@Override
  public boolean isCountingModification(char modType) {
    return true;
  }

  \@Override
  public boolean isReadAllowed() {
    return true;
  }

  \@Override
  public boolean expireCache(long maxSerial) {
    getCache().expire(maxSerial);
    return true;
  }

  \@Override
  public @(pdoName)@ selectCachedOnly(long id) {
    return getCache().select(getDomainContext(), id, false);
  }

  \@Override
  public @(pdoName)@ selectCached(long id) {
    return getCache().select(getDomainContext(), id);
  }
@[
    for (WurbletParameter key: getExpressionParameters()) {
      String type   = key.getAttribute().getJavaType();
      String suffix = key.getAttribute().getMethodNameSuffix();
]@

  /**
   * Selects from cache by @(key.getName())@ but does not load from db if not in cache.
   *
   * \@param @(key.getArg())@ the unique key
   * \@return the pdo, null if not in cache
   */
  \@Override
  public @(pdoName)@ selectCachedOnlyBy@(suffix)@(@(type)@ @(key.getArg())@)  {
    return getCache().select(@(key.getName())@Index, getDomainContext(), @(key.getArg())@, false);
  }

  /**
   * Selects via cache by @(key.getName())@.
   *
   * \@param @(key.getArg())@ the unique key
   * \@return the pdo, null if no such object
   */
  \@Override
  public @(pdoName)@ selectCachedBy@(suffix)@(@(type)@ @(key.getArg())@)  {
    return getCache().select(@(key.getName())@Index, getDomainContext(), @(key.getArg())@);
  }
@[
    }

    if (genudk) {
]@

  /**
   * Selects from cache by unique domain key but does not load from db if not in cache.
   *
   * \@param @(udkName)@ the unique domain key
   * \@return the pdo, null if not in cache
   */
  \@Override
  public @(pdoName)@ selectCachedOnlyByUniqueDomainKey(@(udkType)@ @(udkName)@)  {
    return getCache().select(udkIndex, getDomainContext(), @(udkName)@, false);
  }

  /**
   * Selects via cache by unique domain key.
   *
   * \@param @(udkName)@ the unique key
   * \@return the pdo, null if no such object
   */
  \@Override
  public @(pdoName)@ selectCachedByUniqueDomainKey(@(udkType)@ @(udkName)@)  {
    return getCache().select(udkIndex, getDomainContext(), @(udkName)@);
  }
@[
    }

    if (preload)  {
]@

  \@Override
  public List<@(bounded ? "? extends " : "")@@(pdoName)@> selectAllCached() {
    return getCache().selectAll(getDomainContext());
  }
@[
