  /**
   * create a code for setting up an PdoCache
   *
   * usage:  \@wurblet <somename> PdoCache --model=<mapfile> [--cache=<classname>] [--secure]
   *                   [--public] [--preload] [--mutable] [--noreg] [--udk] [--bounded] [index1] [index2] ...
   *         --secure if cache must check read permission (default is no check)
   *         --preload will generate an autopreloading cache
   *         --mutable generates a non-shared cache, i.e. mutable PDOs (by default a shared readonly cache is generated)
   *         --public makes the cache and indexes public (default is private!)
   *         --immediate forces immediate expiration (by using the ModificationThread's db-connection)
   *         --cache=<classname> sets the cache-class. If missing "PdoCache".
   *         --noreg will not register the cache globally (default is to register if cache=PdoCache)
   *         --bounded returns a bounded List<? extends ...> for selectAllCached
   *         --udk create index for unique domain key
   *         --strategy=<LRU|LFU|FORGET>    the caching strategy (default is FORGET)
   *         --maxsize=<maximum number of pdos>   the cache size (if not preload)
   *         --keepquota=<quota> percentage of entries to keep when applying caching strategy, default 50
   *         --configure=<method> an optional method to configure the cache
   *
   *         index1, ... are additional unique indexes to create. By default, only the ID-index
   *         will be created.
   *
   * Example: \@wurblet cache PdoCache --model=$mapfile --preload artikelNr
   */

  // main class
  String mainClass   = getClassName();
  String pdoName     = getPdoClassName();

  boolean secure     = false;
  boolean preload    = false;
  boolean mutable    = false;
  boolean delayed    = true;
  boolean noreg      = false;
  boolean genudk     = false;
  boolean bounded    = false;

  String cache       = "PdoCache";
  String scope       = "private";

  String strategy    = null;
  Integer maxSize    = null;
  Integer keepQuota  = null;
  String configure   = null;

  for (String arg: getOptionArgs())  {
    if (arg.equals("preload")) {
      preload = true;
    }
    else if (arg.equals("secure")) {
      secure = true;
    }
    else if (arg.equals("mutable")) {
      mutable = true;
    }
    else if (arg.equals("immediate")) {
      delayed = false;
    }
    else if (arg.equals("public")) {
      scope = "public";
    }
    else if (arg.equals("noreg")) {
      noreg = true;
    }
    else if (arg.equals("bounded")) {
      bounded = true;
    }
    else if (arg.equals("udk")) {
      genudk = true;
    }
    else if (arg.startsWith("cache=")) {
      cache = arg.substring(6);
    }
    else if (arg.startsWith("strategy=")) {
      strategy = arg.substring(9).toUpperCase();
    }
    else if (arg.startsWith("maxsize=")) {
      maxSize = Integer.valueOf(arg.substring(8));
    }
    else if (arg.startsWith("keepquota=")) {
      keepQuota = Integer.valueOf(arg.substring(10));
    }
    else if (arg.startsWith("configure=")) {
      configure = arg.substring(10);
    }
  }

  if (secure && !getEntity().isRootEntityAccordingToModel()) {
    throw new WurbelException(getEntity() + " is not a root-entity");
  }

  // align args
  if (!cache.equals("PdoCache"))  {
    noreg = true;
  }

  List<Attribute> udk = null;
  String udkType = null;
  String udkName = null;
  String udkSuffix = null;
  if (genudk) {
    udk = getEntity().getUniqueDomainKey();
    if (!udk.isEmpty()) {
      if (udk.size() == 1) {
        udkType = udk.get(0).getJavaType();
        udkName = udk.get(0).getJavaName();
        udkSuffix = udk.get(0).getMethodNameSuffix();
      }
      else {
        udkType = getEntity().getName() + "UDK";
        udkName = "udk";
        udkSuffix = "UniqueDomainKey";
      }
    }
    else {
      udk = null;
      genudk = false;
    }
  }


  if (getEntity().isAbstract()) {
    List<Entity> leafs = getEntity().getLeafEntities();
]@

  \@Override
  \@SuppressWarnings("unchecked")
  public T selectCached(long id) {
@[
    boolean first = true;
    for (Entity leaf: leafs) {
      if (first)  {
]@
    T pdo = (T) Pdo.create(@(leaf)@.class, getDomainContext()).selectCached(id);
@[
        first = false;
      }
      else {
]@
    if (pdo == null) {
      pdo = (T) Pdo.create(@(leaf)@.class, getDomainContext()).selectCached(id);
    }
@[
      }
    }
]@
    return pdo;
  }

  \@Override
  \@SuppressWarnings("unchecked")
  public T selectCachedOnly(long id) {
@[
    first = true;
    for (Entity leaf: leafs) {
      if (first)  {
]@
    T pdo = (T) Pdo.create(@(leaf)@.class, getDomainContext()).selectCachedOnly(id);
@[
        first = false;
      }
      else {
]@
    if (pdo == null) {
      pdo = (T) Pdo.create(@(leaf)@.class, getDomainContext()).selectCachedOnly(id);
    }
@[
      }
    }
]@
    return pdo;
  }
@[
    if (preload) {
]@

  \@Override
  \@SuppressWarnings("unchecked")
  public List<T> selectAllCached() {
    List<T> pdos = new ArrayList<>();
@[
    for (Entity leaf: leafs) {
]@
    pdos.addAll((Collection<? extends T>) Pdo.create(@(leaf)@.class, getDomainContext()).selectAllCached());
@[
    }
]@
    return pdos;
  }
@[
    }

    for (WurbletParameter key: getExpressionParameters()) {
      String type = key.getAttribute().getJavaType();
      String suffix = Character.toUpperCase(key.getName().charAt(0)) + key.getName().substring(1);
]@

  \@Override
  \@SuppressWarnings("unchecked")
  public T selectCachedBy@(suffix)@(@(type)@ @(key.getName())@) {
@[
      first = true;
      for (Entity leaf: leafs) {
        if (first)  {
]@
    T pdo = (T) Pdo.create(@(leaf)@.class, getDomainContext()).selectCachedBy@(suffix)@(@(key.getName())@);
@[
          first = false;
        }
        else {
]@
    if (pdo == null) {
      pdo = (T) Pdo.create(@(leaf)@.class, getDomainContext()).selectCachedBy@(suffix)@(@(key.getName())@);
    }
@[
        }
      }
]@
    return pdo;
  }

  \@Override
  \@SuppressWarnings("unchecked")
  public T selectCachedOnlyBy@(suffix)@(@(type)@ @(key.getName())@) {
@[
      first = true;
      for (Entity leaf: leafs) {
        if (first)  {
]@
    T pdo = (T) Pdo.create(@(leaf)@.class, getDomainContext()).selectCachedOnlyBy@(suffix)@(@(key.getName())@);
@[
          first = false;
        }
        else {
]@
    if (pdo == null) {
      pdo = (T) Pdo.create(@(leaf)@.class, getDomainContext()).selectCachedOnlyBy@(suffix)@(@(key.getName())@);
    }
@[
        }
      }
]@
    return pdo;
  }
@[
    }

    if (genudk) {
]@

  \@Override
  \@SuppressWarnings("unchecked")
  public T selectCachedByUniqueDomainKey(@(udkType)@ @(udkName)@) {
@[
      first = true;
      for (Entity leaf: leafs) {
        if (first)  {
]@
    T pdo = (T) Pdo.create(@(leaf)@.class, getDomainContext()).selectCachedByUniqueDomainKey(@(udkName)@);
@[
          first = false;
        }
        else {
]@
    if (pdo == null) {
      pdo = (T) Pdo.create(@(leaf)@.class, getDomainContext()).selectCachedByUniqueDomainKey(@(udkName)@);
    }
@[
        }
      }
]@
    return pdo;
  }

  \@Override
  \@SuppressWarnings("unchecked")
  public T selectCachedOnlyByUniqueDomainKey(@(udkType)@ @(udkName)@) {
@[
      first = true;
      for (Entity leaf: leafs) {
        if (first)  {
]@
    T pdo = (T) Pdo.create(@(leaf)@.class, getDomainContext()).selectCachedOnlyByUniqueDomainKey(@(udkName)@);
@[
