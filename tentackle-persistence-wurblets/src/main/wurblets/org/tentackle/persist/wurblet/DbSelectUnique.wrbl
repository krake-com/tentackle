      // create includes
      RemoteIncludes genInc = new RemoteIncludes(this);
      PrintStream implOut   = genInc.getImplementationStream();
      PrintStream remoteOut = genInc.getInterfaceStream();
]@
    Db db = getSession();
    if (db.isRemote())  {
@{to remoteOut}@
  @(rmiReturnType)@ @(methodName)@(@(params)@);
@{to implOut}@

  \@Override
  public @(rmiReturnType)@ @(methodName)@(@(params)@) {
    return newInstance().@(methodName)@(@(iparms)@);
  }
@{to}@
