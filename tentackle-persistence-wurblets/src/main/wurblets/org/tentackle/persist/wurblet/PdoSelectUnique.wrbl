@{include $currentDir/header.incl}@
@{comment
<strong>({\@code \@wurblet})</strong> Generate code to select an entity.
<p>
usage:<br>
&#064;wurblet &lt;tag&gt; PdoSelectUnique
    [--private] [--noif] [--append=&lt;sqltext&gt;] [--classvar=&lt;classvariables&gt;]
    [--sort] [--lock]
    &lt;expression&gt;
<p>
arguments:
<ul>
<li><em>--private:</em> makes the method private (default is public).</li>
<li><em>--noif:</em> there is no interface (don't generate \@Override).</li>
<li><em>--append=&lt;sqltext&gt;:</em> appends an sql-string.</li>
<li><em>--classvar=&lt;classvariables&gt;:</em> reference to classvariables, if pick the statement-IDs from there.</li>
<li><em>--sort:</em> sort according to orderBy()-method.</li>
<li><em>--lock:</em> generates SELECT FOR UPDATE.</li>
<li><em>&lt;expression&gt;:</em> see {\@link WurbletParameterParser}.</li>
</ul>
For more options, see {\@link DbModelWurblet}.
}@
@[
  private void wurbel() throws WurbelException {

    assertEntityIsPersistable();

    if (!getExtraParameters().isEmpty()) {
      String msg = "unexpected extra parameters:";
      for (WurbletParameter par: getExtraParameters()) {
        msg += " " + par;
      }
      throw new WurbelException(msg);
    }

    String className  = getClassName();
    String methodName = getMethodName();
    String pdoName    = getPdoClassName();
    String returnType = pdoName;
    String poType     = className;
    if (isGenerified()) {
      returnType = "T";
      poType = "P";
    }

    boolean sort        = false;
    boolean lock        = false;
    String  append      = null;
    boolean noif        = false;
    String  scope       = "public";

    for (String arg: getOptionArgs())  {
      if (arg.equals("private")) {
        scope = "private";
      }
      else if (arg.equals("noif")) {
        noif = true;
      }
      else if (arg.equals("sort")) {
        if (isWithDefaultSorting()) {
          if (isWithSorting()) {
            throw new WurbelException("either default sorting (--sort) or explicit sorting (+/-AN) allowed");
          }
          sort = true;
        }
        else {
          throw new WurbelException("no sorting configured in model for " + getEntity());
        }
      }
      else if (arg.equals("lock")) {
        lock = true;
      }
      else if (arg.startsWith("append=")) {
        append = arg.substring(7);
      }
    }

    if (scope.equals("private")) {
      setRemote(false);
      noif = true;
    }

    if (methodName == null) {
      throw new WurbelException("can't determine <methodname>");
    }
    if (getExpressionParameters().isEmpty() && !sort && append == null && getContextAttribute() == null) {
      throw new WurbelException("no keys given");
    }

    String params = buildMethodParameters();
    String iparms = buildInvocationParameters();
    String statementId = createStatementId();
    String reflMethod = getGuardName() + "Method";
    boolean needLimit = sort || append != null || createOrderBy() != null;
    boolean whereWithAliases = true;   // for genwhere.incl

    String alias = getEntity().getTopSuperEntity().getTableAlias();
    String poImpl = deriveClassNameForEntity(getEntity());

]@

  private static final StatementId @(statementId)@ = new StatementId();

@[
    if (!noif) {
]@
  \@Override
@[
    }
]@
  @(scope)@ @(returnType)@ @(methodName)@(@(as(params))@) {
@[
    if (isRemote()) {
      // create includes
      RemoteIncludes genInc = new RemoteIncludes(this);
      PrintStream implOut   = genInc.getImplStream();
      PrintStream remoteOut = genInc.getRemoteStream();
]@
    if (getSession().isRemote())  {
      // invoke remote method
      try {
@{to remoteOut}@
  @(returnType)@ @(methodName)@(@(pcs(params, "DomainContext context"))@) throws RemoteException;
@{to implOut}@

  \@Override
  public @(returnType)@ @(methodName)@(@(pcs(params, "DomainContext context"))@) throws RemoteException {
    try {
      return newInstance(context).@(methodName)@(@(iparms)@);
    }
    catch (Exception e) {
      throw createException(e);
    }
  }
@{to}@
        @(returnType)@ obj = getRemoteDelegate().@(methodName)@(@(pcs(iparms, "getDomainContext()"))@);
        configureRemoteObject(getDomainContext(), obj);
        return obj;
      }
      catch (RemoteException e) {
        throw PersistenceException.createFromRemoteException(this, e);
      }
    }
    // else: local mode
@[
    } // end if remote

    Collection<LeftJoin> joins = getLeftJoins();
    if (!joins.isEmpty()) {
]@
    JoinedSelect<@(returnType)@> js = new JoinedSelect<@(returnType)@>()
@[
      int joinCount = 0;
      for (LeftJoin join: joins) {
        Relation rel = join.getRelation();
        joinCount++;
        String joinClass = rel.getForeignEntity().getName();
        String joinAlias = rel.getForeignEntity().getTableProvidingEntity().getTableAlias();
        if (rel.getRelationType() == RelationType.LIST) {
]@
      .addJoin(
        new Join<>(JoinType.LEFT, getColumnName(CN_ID), "j_@(joinCount)@.@(rel.getForeignAttribute().getColumnName())@", @(joinClass)@.class, "j_@(joinCount)@",
          (@(alias)@, @(joinAlias)@) -> {
@[
          if (rel.isReversed()) {
]@
            ((@(poImpl)@) @(alias)@.getPersistenceDelegate()).@(rel.getSetterName())@@(rel.isSerialized()?"Blunt":"")@(@(joinAlias)@);
@[
          }
          else {
]@
            ((@(poImpl)@) @(alias)@.getPersistenceDelegate()).@(rel.getGetterName())@Blunt().addBlunt(@(joinAlias)@);
@[
            if (rel.getLinkMethodName() != null) {
              String joinImpl = deriveClassNameForEntity(rel.getForeignEntity());
]@
            ((@(joinImpl)@) @(joinAlias)@.getPersistenceDelegate()).@(createRelationUpdateReferenceCode(rel, alias))@;
@[
            }
          }
]@
          }
        )
      )@(joinCount == getJoinedRelations().size() ? ";" : "")@
@[
        }
        else  {
]@
      .addJoin(
        new Join<>(JoinType.LEFT, getColumnName(CN_@(rel.getAttribute().getJavaName().toUpperCase())@), "j_@(joinCount)@.id", @(joinClass)@.class, "j_@(joinCount)@",
          (@(alias)@, @(joinAlias)@) -> {
            ((@(poImpl)@) @(alias)@.getPersistenceDelegate()).@(rel.getSetterName())@@(rel.isSerialized()?"Blunt":"")@(@(joinAlias)@);
          }
        )
      )@(joinCount == getJoinedRelations().size() ? ";" : "")@
@[
        }
      }
    }

]@
    PreparedStatementWrapper st = getPreparedStatement(@(statementId)@,
      () -> {
        StringBuilder sql = createSelectAllInnerSql();
@{include $currentDir/genwhere.incl}@
        getBackend().buildSelectSql(sql, @(lock ? "true" : "false")@, @(needLimit ? 1 : 0)@, 0);
@[
    if (sort) {
]@
        String orderSuffix = orderBy();
        if (orderSuffix != null && !orderSuffix.isEmpty()) {
          sql.append(Backend.SQL_ORDERBY).append(orderSuffix);
        }
@[
    }
    if (append != null)  {
]@
        sql.append(' ');
        sql.append(@(append)@);
@[
    }
]@@{include $currentDir/genjoinsql.incl}@
        return sql.toString();
      }
    );
@[
    if (needLimit) {
]@
    int ndx = getBackend().setLeadingSelectParameters(st, 1, 0);
@[
    }
    else  {
]@
    int ndx = 1;
@[
    }

    if (!getJoinedRelations().isEmpty()) {
]@
    ndx = js.setClassIdsInStatement(st, ndx);
@[
    }
]@
@{include $currentDir/gensetpar.incl}@
@[
    if (needLimit) {
]@
    getBackend().setTrailingSelectParameters(st, ndx, 1, 0);
@[
    }
    if (getJoinedRelations().isEmpty()) {
]@
    return executeFirstPdoQuery(st);
@[
    }
    else  {
]@
    return executeFirstPdoQuery(st, js);
@[
    }
]@
  }
@[
  }
]@