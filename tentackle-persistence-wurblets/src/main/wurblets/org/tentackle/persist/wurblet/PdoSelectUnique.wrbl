@{include $currentDir/header.incl}@
@{config pathAllowed}@
@{comment
<strong>({\@code \@wurblet})</strong> Generate code to select an entity.
<p>
usage:<br>
&#064;wurblet &lt;tag&gt; PdoSelectUnique
    [--private] [--noif] [--oneshot] [--append=&lt;sqltext&gt;] [--classvar=&lt;classvariables&gt;]
    [--sort] [--lock] [--tokenlock] [--immutable] [--finallyImmutable] [--mutable]
    &lt;expression&gt;
<p>
arguments:
<ul>
<li><em>--private:</em> makes the method private (default is public).</li>
<li><em>--noif:</em> there is no interface (don't generate \@Override).</li>
<li><em>--oneshot:</em> use the prepared statement only once (no StatementId)</li>
<li><em>--append=&lt;sqltext&gt;:</em> appends an sql-string.</li>
<li><em>--classvar=&lt;classvariables&gt;:</em> reference to classvariables, if pick the statement-IDs from there.</li>
<li><em>--sort:</em> sort according to orderBy()-method.</li>
<li><em>--lock:</em> generates SELECT FOR UPDATE.</li>
<li><em>--tokenlock:</em> requests a token-lock.</li>
<li><em>--immutable:</em> the returned PDO is immutable.</li>
<li><em>--finallyImmutable:</em> the returned PDO is finally immutable.</li>
<li><em>--mutable:</em> the returned list is mutable (to override automatic immutability if filtered joins are used).</li>
<li><em>&lt;expression&gt;:</em> see {\@link WurbletArgumentParser}.<br>
Conditions marked with <em>?&lt;boolean&gt;</em> are optional, i.e. become part of the query only if the
boolean method argument is true. Such finders always create a one-shot prepared statement.</li>
</ul>
For more options, see {\@link DbModelWurblet}.
}@
@[
  private void wurbel() throws WurbelException, ModelException {

    assertEntityNotEmbedded();
    assertEntityIsPersistable();

    String className  = getClassName();
    String methodName = getMethodName();
    String pdoName    = getPdoClassName();
    String pdoType    = pdoName;
    String returnType = pdoName;
    String poType     = className;
    String classVar   = null;

    if (isGenerified()) {
      returnType = "T";
      poType = "P";
    }

    boolean sort              = false;
    boolean lock              = false;
    boolean tokenlock         = false;
    String  append            = null;
    boolean noif              = false;
    boolean oneshot           = isWithOptionalArguments();   // optional conditions imply --oneshot
    boolean immutable         = false;
    boolean finallyImmutable  = false;
    boolean forceMutable      = false;
    String  scope             = "public";

    for (String arg: getOptionArgs())  {
      if (arg.equals("private")) {
        scope = "private";
        noif = true;
      }
      else if (arg.equals("noif")) {
        noif = true;
      }
      else if (arg.equals("oneshot")) {
        oneshot = true;
      }
      else if (arg.equals("immutable")) {
        immutable = true;
      }
      else if (arg.equals("finallyimmutable")) {
        finallyImmutable = true;
      }
      else if (arg.equals("mutable")) {
        forceMutable = true;
      }
      else if (arg.equals("sort")) {
        if (isWithDefaultSorting()) {
          if (isWithSorting()) {
            throw new WurbelException("either default sorting (--sort) or explicit sorting (+/-AN) allowed");
          }
          sort = true;
        }
        else {
          throw new WurbelException("no sorting configured in model for " + getEntity());
        }
      }
      else if (arg.equals("lock")) {
        lock = true;
      }
      else if (arg.equals("tokenlock")) {
        tokenlock = true;
      }
      else if (arg.startsWith("append=")) {
        append = arg.substring(7);
      }
      else if (arg.startsWith("classvar="))  {
        classVar = arg.substring(9);
      }
    }

    if (scope.equals("private")) {
      setRemote(false);
      noif = true;
    }

    if (classVar == null) {
      classVar = "";
    }
    else  {
      classVar += ".";    // add dot to access class var
    }

    if (methodName == null) {
      throw new WurbelException("can't determine <methodname>");
    }
    if (getExpressionArguments().isEmpty() && !sort && !isWithSorting() && append == null && getContextAttribute() == null) {
      throw new WurbelException("no keys given");
    }

    String params = buildMethodParameters();
    String iparms = buildInvocationParameters();
    String statementId = createStatementId();
    String reflMethod = getGuardName() + "Method";
    boolean needLimit = sort || append != null || createOrderBy() != null;
    String alias = getEntity().getTopSuperEntity().getTableAlias();
    String poImpl = deriveClassNameForEntity(getEntity());

    List<JoinPath> joinPaths = getJoinPaths();
    boolean withJoins = !joinPaths.isEmpty();
    boolean needSuppressWarnings = withJoins && isAbstractJoinPath(joinPaths);

    if (!forceMutable && isWithFilteredJoins(true)) {
      immutable = true;
    }

    if (!noif) {
