]@
    return Backend.SQL_INSERT_INTO + @(multiInheritance ? "CLASSVARIABLES." : "")@getTableName() + Backend.SQL_LEFT_PARENTHESIS +
@[

        int count = 0;
        for (String name: names) {
          String lineSep = count == names.size() - 1 ? " +" : " + Backend.SQL_COMMA +";
]@
           CN_@(name)@@(lineSep)@
@[
          count++;
        }
]@
           Backend.SQL_INSERT_VALUES +
@[
        while (--count > 0)	{
]@
           Backend.SQL_PAR_COMMA +
@[
        }
]@
           Backend.SQL_PAR + Backend.SQL_RIGHT_PARENTHESIS;
  }
@[

    names.clear();
