        else  {
          jdbcCode += ")";
        }
]@
    @(jdbcCode)@;
@[

        // for multi column types, such as BMoney/DMoney
        for (int p = 1; p < attr.getDataType().getSqlTypes().length; p++) {
]@
    ++ndx;
@[
        }
      }
    }

    if (multiInheritance && getEntity().getSuperEntity() != null) {
]@
    st.setLong(++ndx, getId());
@[
    }
]@
    return ndx;
  }
