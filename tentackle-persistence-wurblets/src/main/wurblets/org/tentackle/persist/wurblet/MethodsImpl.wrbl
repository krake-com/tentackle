@[
    }

    for (Attribute attr: getEntity().getMappedAttributes()) {
      if (!attr.getOptions().isDerived() && !attr.getOptions().isReadOnly())  {
        String setterName = createJdbcSetterName(attr);

        String modelCode;
        if (isSetGetRequired(attr)) {
          modelCode = attr.getGetterName() + "()";
