  \@Override
  public StringBuilder createSelectAllInnerSql() {
    StringBuilder sql = new StringBuilder();
@[
        boolean needComma = false;
        for (Entity entity: chain) {
          String implClass = deriveClassNameForEntity(entity);
]@
    sql.@(needComma ? "append(Backend.SQL_COMMA)." : "")@append(@(implClass)@.CLASSVARIABLES.getColumnName(Backend.SQL_ALLSTAR));
@[
          needComma = true;
          if (entity == topEntity) {
            for (Entity sub: subs) {
              implClass = deriveClassNameForEntity(sub);
]@
    sql.append(Backend.SQL_COMMA).append(@(implClass)@.CLASSVARIABLES.getColumnName(Backend.SQL_ALLSTAR));
@[
            }
          }
        }
]@
    sql.append(Backend.SQL_FROM);
    sql.append(@(topImplClass)@.CLASSVARIABLES.getTableName()).
        append(getBackend().sqlAsBeforeTableAlias()).append(@(topImplClass)@.CLASSVARIABLES.getTableAlias());
@[
        if (chain.size() > 1) {
          for (Entity entity: chain.subList(1, chain.size())) {
            String implClass = deriveClassNameForEntity(entity);
]@
    sql.append(getBackend().sqlJoin(JoinType.INNER,
               @(implClass)@.CLASSVARIABLES.getTableName(), @(implClass)@.CLASSVARIABLES.getTableAlias(),
               @(topImplClass)@.CLASSVARIABLES.getColumnName(CN_ID) + Backend.SQL_EQUAL +
               @(implClass)@.CLASSVARIABLES.getColumnName(CN_ID)));
@[
          }
        }

        for (Entity sub: subs) {
          String implClass = deriveClassNameForEntity(sub);
]@
    sql.append(getBackend().sqlJoin(JoinType.LEFT,
               @(implClass)@.CLASSVARIABLES.getTableName(), @(implClass)@.CLASSVARIABLES.getTableAlias(),
               @(topImplClass)@.CLASSVARIABLES.getColumnName(CN_ID) + Backend.SQL_EQUAL +
               @(implClass)@.CLASSVARIABLES.getColumnName(CN_ID)));
@[
        }
]@
    sql.append(Backend.SQL_WHEREALL);
    return sql;
  }

@[
