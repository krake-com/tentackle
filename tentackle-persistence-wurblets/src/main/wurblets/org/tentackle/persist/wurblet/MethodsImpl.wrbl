    /**
     * create a getter and setter methods for db-attributes.
     *
     * usage:  \@wurblet <somename> MethodsImpl --model=<mapfile> [--remote] [--tracked] [--attracked] [--fulltracked] [--noif] [--noudk]
     *         --remote generate covariant getRemoteDelegate()
     *         --tracked will create setModified()-code in setter methods
     *         --attracked same as tracked but generate code on attribute level as well
     *         --fulltracked sames as attracked but keeps the original value since last persistence operation
     *         --noif: there is no interface (don't generate \@Override)
     *         --noudk don't generate selectByUniqueDomainKey wurblet
     *
     * Example: \@wurblet methods MethodsImpl --model=$scripts/artikel.map --tracked
     */

    // main class
    String mainClass = getClassName();
    String pdoClass = null;
    boolean isPdo;
    try {
      pdoClass = getPdoClassName();
      isPdo = true;
    }
    catch (WurbelException we) {
      isPdo = false;
    }

    boolean noif = false;
    boolean generateSnapshot = false;
    boolean generateSelectByUDK = true;

    int argcount = 0;
    for (String arg: getOptionArgs())  {
      if ("noif".equals(arg)) {
        noif = true;
      }
      else if ("noudk".equals(arg)) {
        generateSelectByUDK = false;
      }
    }

    if (isRemote() && isPdo) {
      new RemoteIncludes(this);   // create RMI-files if they don't exist yet
      String delegateType = pdoClass + "RemoteDelegate";
      if (getEntity().isAbstract()) {
        delegateType += "<T,P>";
      }
]@

  \@Override
  public @(delegateType)@ getRemoteDelegate() {
    return (@(delegateType)@) super.getRemoteDelegate();
  }
