  <artifactId>tentackle-project-archetype</artifactId>
  <packaging>maven-archetype</packaging>
  <name>Tentackle Project Archetype</name>
  <description>Archetype for a multi-module Tentackle application</description>

  <properties>
    <rootBasedir>${project.parent.basedir}</rootBasedir>
  </properties>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>archetype-resources/pom.xml</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>archetype-resources/pom.xml</exclude>
        </excludes>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <configuration>
          <escapeString>\</escapeString>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    The archetype must be built last in the reactor, since its integration test builds a generated
    project against the installed artifacts (and the archetype plugin isn't thread-safe).
    Dependencies listed only in the dependencyManagement of tentackle-bom do not order the reactor,
    so every module is listed here explicitly. Keep this list in sync with the root pom's modules!
  -->
