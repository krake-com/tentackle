<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.tentackle</groupId>
    <artifactId>tentackle-parent</artifactId>
    <version>25.0-SNAPSHOT</version>
  </parent>

  <artifactId>tentackle-i18n-maven-plugin</artifactId>
  <packaging>maven-plugin</packaging>
  <name>Tentackle I18N Maven Plugin</name>
  <description>Maven Plugin for Localization Tooling</description>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>tentackle-maven-support</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-plugin-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.maven.resolver</groupId>
      <artifactId>maven-resolver-api</artifactId>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>tentackle-i18n</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>tentackle-pdo</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>tentackle-persistence</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>tentackle-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <!-- the test backend: the mojo tests run against the stored bundles of an in-memory H2 -->
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <properties>
    <rootBasedir>${project.parent.basedir}</rootBasedir>
  </properties>

  <build>

    <testResources>
      <testResource>
        <!-- the default, overridden by the generated one below and hence to be listed explicitly -->
        <directory>src/test/resources</directory>
      </testResource>
      <testResource>
        <!-- the DDL of the stored bundles, generated below -->
        <directory>target/generated-test-resources</directory>
      </testResource>
    </testResources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-plugin-plugin</artifactId>
        <executions>
          <execution>
            <id>default-descriptor</id>
            <phase>process-classes</phase>
            <goals>
              <goal>descriptor</goal>
            </goals>
          </execution>
          <execution>
            <id>help-goal</id>
            <goals>
              <goal>helpmojo</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!--
          Create the DDL of the tables the mojo tests need, so that AbstractI18nMojoDbTest can
          build the schema of the in-memory H2 from the classpath. The recipe is the one of
          tentackle-persistence: this module sits below tentackle-test-pdo in the reactor and
          cannot use its DbTestUtilities, which would build the same script from the model.
        -->
        <groupId>${project.groupId}</groupId>
        <artifactId>tentackle-sql-maven-plugin</artifactId>
        <version>${project.version}</version>
        <executions>
          <execution>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>create</goal>
            </goals>
            <configuration>
              <verbosity>info</verbosity>
              <generateHeaderComment>false</generateHeaderComment>
              <checkReservedTables>false</checkReservedTables>
              <backendNames>H2</backendNames>
              <sqlDir>${project.build.directory}/generated-test-resources/META-INF/sql</sqlDir>
              <sqlFileName>createttmodel.sql</sqlFileName>
              <filesets>
                <fileset>
                  <!--
                    The model dir is shared by the whole reactor, so the entities must be named
                    explicitly. Otherwise, an incremental build would pull in the models of other
                    modules as well.
                    bundle and bundlekey are the tables the i18n mojos work on; modification and
                    modlog are needed because saving a stored bundle counts its modification.
                  -->
                  <directory>${tentackle.modelDir}</directory>
                  <includes>
                    <include>bundle.map</include>
                    <include>bundlekey.map</include>
                    <include>modification.map</include>
                    <include>modlog.map</include>
                  </includes>
                </fileset>
              </filesets>
              <sequences>
                <sequence>
                  <name>object_sequence_id</name>
                  <comment>to generate the ID of PDOs</comment>
                </sequence>
              </sequences>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>org.tentackle.maven.plugin.i18n</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <!-- automatic module name screws it up -->
          <legacyMode>true</legacyMode>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
