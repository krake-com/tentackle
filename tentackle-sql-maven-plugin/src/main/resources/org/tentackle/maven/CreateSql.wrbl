@{package org.tentackle.wurblets}@
@{import java.util.*}@
@{extends SqlWurblet}@
@{args}@
@[
    /**
     * Tentackle - http://www.tentackle.org
     * Copyright (C) 2001-2008 Harald Krake, harald\@krake.de, +49 7722 9508-0
