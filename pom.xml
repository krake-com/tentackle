    <maven.resources.plugin.version>3.5.0</maven.resources.plugin.version>
    <maven.site.plugin.version>3.22.0</maven.site.plugin.version>
    <maven.fluido.skin.version>2.1.0</maven.fluido.skin.version>
    <maven.source.plugin.version>3.4.0</maven.source.plugin.version>
    <maven.surefire.plugin.version>3.6.0</maven.surefire.plugin.version>
    <!-- Surefire 3.6.0's unified JUnit-Platform TestNG engine has a confirmed upstream regression
         evaluating cross-class dependsOnGroups during its classpath scan (see
         https://github.com/apache/maven-surefire/issues/3457), which breaks
         RemoteTransactionTest's remote1-depends-on-local group dependency. tentackle-test-pdo and
         tentackle-test-fx-rdc pin the plugin (and its surefire-testng provider) back to the last
         working 3.5.x release until that's fixed upstream - see their poms. -->
    <maven.surefire.plugin.pinned.version>3.5.6</maven.surefire.plugin.pinned.version>
    <maven.versions.plugin.version>2.22.0</maven.versions.plugin.version>
    <maven.central-publishing.plugin.version>0.11.0</maven.central-publishing.plugin.version>

    <maven.build.timestamp.format>yyyy-MM-dd HH:mm</maven.build.timestamp.format>

    <tentackle.serviceDir>${project.build.directory}/generated-resources</tentackle.serviceDir>
    <tentackle.testServiceDir>${project.build.directory}/generated-test-resources</tentackle.testServiceDir>
    <tentackle.manifestDirectory>${project.build.directory}/generated-resources/manifest</tentackle.manifestDirectory>
    <netbeans.hint.license>tentackle</netbeans.hint.license>

    <wurbelizer.version>25.0-SNAPSHOT</wurbelizer.version>
    <!-- override the default wurbelDir for multi-module project -->
    <wurbel.wurbelDir>${rootBasedir}/target/wurbel</wurbel.wurbelDir>

    <!-- for the tentackle sql plugin -->
    <tentackle.modelDir>${wurbel.wurbelDir}/model</tentackle.modelDir>
    <tentackle.sqlDir>${wurbel.wurbelDir}/sql</tentackle.sqlDir>

    <!-- CI test database (postgres-related tests only, not used for the build)-->
    <dbUrl>jdbc:postgresql://localhost/tentackle</dbUrl>
    <dbUser>tentackle</dbUser>
    <dbPasswd>tentackle</dbPasswd>
    <dbService>trip://localhost:24321/TestServer</dbService>

  </properties>

