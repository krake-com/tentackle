<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  The default suite (testng.xml) plus the "postgres" group.

  Activated by the "postgres" profile: mvn -Ppostgres test
  Requires a populated PostgreSQL database as configured by the dbUrl/dbUser/dbPasswd
  properties, which are filtered into src/test/filtered-resources/postgres.properties.
-->
<suite name="PdoTests">
  <test thread-count="1" name="All">
    <groups>
      <run>
        <include name="local"></include>
        <include name="remote1"></include>
        <include name="remote2"></include>
        <include name="postgres"></include>
      </run>
    </groups>
    <packages>
      <package name="org.tentackle.*"></package>
    </packages>
  </test>
</suite>
