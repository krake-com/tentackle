<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  The "benchmark" group only: throughput harnesses, not correctness tests.

  Activated by the "benchmark" profile: mvn -Pbenchmark test
-->
<suite name="PdoBenchmarks">
  <test thread-count="1" name="All">
    <groups>
      <run>
        <include name="benchmark"></include>
      </run>
    </groups>
    <packages>
      <package name="org.tentackle.*"></package>
    </packages>
  </test>
</suite>
