<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
  <Appenders>
    <!-- The console is blocked in windows by the main test thread.
         Therefore, we need a separate logger to file -->
    <File name="LogToFile" fileName="target/logs/test.log">
      <PatternLayout>
        <Pattern>%d %p %c{1.} [%t] %m%n</Pattern>
      </PatternLayout>
    </File>
  </Appenders>
  <Loggers>
    <Root level="info">
      <AppenderRef ref="LogToFile"/>
    </Root>
  </Loggers>
</Configuration>
