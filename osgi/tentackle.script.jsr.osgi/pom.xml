<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.tentackle</groupId>
    <artifactId>tentackle-parent-osgi</artifactId>
    <version>3.0.3</version>
  </parent>

  <groupId>org.tentackle</groupId>
  <artifactId>tentackle.script.jsr.osgi</artifactId>
  <packaging>bundle</packaging>

  <name>Tentackle Script JSR OSGi Bundle</name>
  <description>OSGi Bundle for the Tentackle Script JSR-223 Module</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>tentackle-script-jsr</artifactId>
      <version>${tentackle.version}</version>
    </dependency>
    <!-- activator in sub-module to avoid inclusion of org.tentackle.common -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>tentackle-script-jsr-osgi-activator</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <configuration>
          <unpackBundle>true</unpackBundle>   <!-- necessary to include all packages for exports and imports -->
          <instructions>
            <Bundle-Activator>org.tentackle.script.jsr.Activator</Bundle-Activator>
            <Import-Package>*;resolution:=optional</Import-Package>
            <Embed-Transitive>false</Embed-Transitive>  <!-- don't bundle transient deps -->
            <Embed-Dependency>*;inline=true;scope=compile|runtime</Embed-Dependency>  <!-- don't bundle test deps -->
            <!-- create OSGI-OPT/src/... -->
            <_sourcepath>../tentackle-osgi-activators/tentackle-script-jsr-osgi-activator/src/main/java,../../tentackle-script-jsr/src/main/java</_sourcepath>
            <_sources>true</_sources>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
