@{include $currentDir/header.incl}@
@{comment
Generate code to define the attribute- and relation-names of an entity.
<p>
usage:<br>
&#064;wurblet &lt;tag&gt; AttributeNames [--noif]
<p>
arguments:
<ul>
<li>&lt;tag&gt; the required wurblet tag. Must be unique within the source file.</li>
<li>--noif: if not part of an interface (adds "public static final")</li>
</ul>
For more options, see {\@link ModelWurblet}.
}@
@[
  private void wurbel() throws WurbelException {

    String mainClass = getClassName();
    String lead = getOption("noif") == null ? "" : "public static final ";

    for (Relation rel: getEntity().getRelations()) {
      String var = rel.getVariableName();
]@

  /** relation name for '@(rel)@'. */
  @(lead)@String RN_@(var.toUpperCase())@ = "@(var)@";
@[
    }

    for (Attribute attr: getEntity().getAttributes())  {
      if (!attr.getOptions().isNoConstant() && !attr.getOptions().isFromSuper())    {
          String name = attr.getJavaName().toUpperCase();
]@

  /** attribute name for database column '@(attr.getColumnName())@'. */
  @(lead)@String AN_@(name)@ = "@(attr.getJavaName())@";
@[
      }
    }
  }
]@