@[
          }
        }
        if (baseColConst != null && (!attr.isEmbedded() || getEntity().isEmbedded())) {
]@

  /** database column basename for @(effectiveType.isColumnCountBackendSpecific() ? "backend-specific " : "")@'@(attr)@'. */
  public static final String @(baseColConst)@ = @(StringHelper.toDoubleQuotes(getColumnName(attr, -1)))@;
@[
        }
      }
    }

    if (allColConst != null && !getEntity().isEmbedded()) {
