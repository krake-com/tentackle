    /**
     * include another file.
     * usage:  \@wurblet <guardname> Include [--comment] [--missingok] [--translate] [--delete] <filename>
     *         --comment means include as comment
     *         --missingok means missing include file is not an error
     *         --translate will translate $variables
     *         --delete will delete the file
     *
     * Example: \@wurblet incmap Include --comment $currentDir/incmap.include
     */

    // read the file to include
    BufferedReader reader = null;
    char[] chars = new char[128];
    StringBuilder outBuf = new StringBuilder(512);
    // copy
    try {
      reader = new BufferedReader(WurbelUtilities.openReader(filename));
      int numRead;
      while((numRead = reader.read(chars)) > -1) {
        outBuf.append(String.valueOf(chars, 0, numRead));
      }
      out.print(translate ? WurbelUtilities.translateVariables(outBuf, getContainer().getProperties(Wurbler.PROPSPACE_WURBLET)) : outBuf);
    }
    catch (IOException ex) {
      throw new WurbelException("including " + filename + " failed", ex);
    }
    catch (WurbelException ex)  {
      if (missingOk && ex.getCause() instanceof FileNotFoundException) {
]@
        // no such file '" + filename + "' (ok)"
@[
      }
      else {
        throw ex;
      }
    }
    finally {
      try {
        reader.close();
      }
      catch (Exception ex) {}
    }
]@
