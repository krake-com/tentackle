  <artifactId>fixprefs</artifactId>
  <version>2.1.0</version>
  <packaging>jar</packaging>
  <name>Tentackle Tool: Fix Preferences</name>
  <description>
    A tool to fix the persisted preferences.
  </description>
  <url>http://www.tentackle.org</url>

  <properties>
    <rootBasedir>${project.parent.parent.basedir}</rootBasedir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>tentackle-pdo</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>tentackle-persistence</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>tentackle-domain</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- add JDBC drivers -->
<!--    <dependency>
      <groupId>com.oracle</groupId>
      <artifactId>ojdbc6</artifactId>
      <version>11.2.0.4</version>
      <scope>runtime</scope>
    </dependency>-->
  </dependencies>

  <build>
    <plugins>
